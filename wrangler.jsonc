// Cloudflare Worker for KoraPulse: serves this folder as a static website, and runs
// worker/index.js for /admin/* (password) and for the pages, to add link previews for social media.
// Deploy: `npx wrangler deploy`, or connect this GitHub repository in the Cloudflare dashboard
// (Workers & Pages → Create → Import a repository) to redeploy on every push.
// Files listed in .assetsignore are not uploaded.
{
  "name": "korapulse",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Stores the admin password changed from the dashboard (salted hash) and failed-login counters.
  "kv_namespaces": [{ "binding": "AUTH", "id": "8b448836c6704bf68b68ade886db1211" }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml", "/matches", "/matches.html", "/page", "/page.html", "/", "/index.html", "/article", "/article.html", "/category", "/category.html", "/og/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
